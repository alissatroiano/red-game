{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "redpordy",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "index.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Vocable",
        "description": "Daily Word Game",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Show Info",
        "description": "Show user information",
        "endpoint": "/internal/menu/show-info",
        "location": "post"
      }
    ]
  },
  "permissions": {
    "http": {
      "enable": true,
      "domains": [
        "raw.githubusercontent.com",
        "raw.githubusercontent.com/sindresorhus/word-list/refs/heads/main/words.txt",
        "github.com"
      ]
    },
    "redis": true
  },
  "triggers": {
    "onAppInstall": "/internal/on-app-install",
    "onPostCreate": "/internal/post-create"
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/cron/daily-job",
        "cron": "0 0 * * *"
      }
    }
  }
}
